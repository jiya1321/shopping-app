{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.cjs": {
      "includeFiles": [
        "dist/index.cjs",
        "dist/public/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.cjs"
    }
  ]
}
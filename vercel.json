{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.cjs": {
      "includeFiles": "api/server.cjs"
    }
  },
  "routes": [
    {
      "src": "/api(?:/(.*))?",
      "dest": "/api/index.cjs"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}